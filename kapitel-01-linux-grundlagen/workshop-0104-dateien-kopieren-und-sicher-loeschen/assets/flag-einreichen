#!/usr/bin/env bash
set -Eeuo pipefail

readonly expected_flag="FLAG{der_waerter_war_hier}"
readonly room="/home/waerter/leuchtturm/obergeschoss/kartenraum"
readonly wall_note="${room}/notiz-aus-der-wand.txt"
readonly submitted="${room}/.flag-submitted"

if (( $# != 1 )); then
  printf '%s\n' "Aufruf: flag-einreichen 'GEFUNDENE_FLAG'" >&2
  exit 2
fi

if [[ ! -f "${wall_note}" || -L "${wall_note}" ]]; then
  printf '%s\n' "Hinter der eingestürzten Ecke wurde noch keine Notiz freigelegt." >&2
  exit 1
fi

if [[ "$1" != "${expected_flag}" ]]; then
  printf '%s\n' "Diese Flag passt nicht zur Notiz aus der Wand." >&2
  printf '%s\n' "Lies notiz-aus-der-wand.txt noch einmal genau mit cat." >&2
  exit 1
fi

marker_tmp="$(mktemp "${room}/.flag-submitted.XXXXXX")" || {
  printf '%s\n' "Die Flag-Abgabe kann ihren Status nicht speichern." >&2
  printf '%s\n' "Starte das Szenario neu und versuche es erneut." >&2
  exit 1
}
printf '%s\n' "wall-flag-submitted" >"${marker_tmp}"
chmod 0640 "${marker_tmp}"
mv -f -- "${marker_tmp}" "${submitted}"
printf '%s\n' "Flag angenommen. Du kannst jetzt den CHECK ausführen."
